# Resolve from the public npm registry.
#
# This is a public repository and the build runs on Cloudflare Pages, so
# every URL in package-lock.json has to be fetchable by anyone. Without
# this, `npm install` on a machine configured against a private registry
# rewrites all 183 `resolved` URLs in the lockfile to that registry's
# host -- which breaks the Cloudflare build (it cannot authenticate) and
# publishes the internal endpoint. That had already happened once.
#
# If you are on a machine that cannot reach registry.npmjs.org directly,
# override it for your shell rather than editing this file, so the
# committed lockfile stays public:
#     npm install --registry https://your.registry.example/
# and check `git diff package-lock.json` for host changes before
# committing.
registry=https://registry.npmjs.org/
